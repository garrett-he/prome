{
    "name": "prome",
    "version": "1.1.0",
    "description": "A personal AI prompts management tool.",
    "keywords": [
        "prompt",
        "ai",
        "llm"
    ],
    "author": {
        "name": "Garrett HE",
        "email": "garrett.he@outlook.com"
    },
    "homepage": "https://github.com/garrett-he/prome#readme",
    "bugs": {
        "url": "https://github.com/garrett-he/prome/issues",
        "email": "garrett.he@outlook.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/garrett-he/prome.git"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "simple-git-hooks",
        "changeset": "changeset",
        "version": "changeset version",
        "tauri": "tauri",
        "icons:generate": "node src-tauri/icons/generate-icons.mjs"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.19",
        "@radix-ui/react-dropdown-menu": "^2.1.20",
        "@radix-ui/react-label": "^2.1.11",
        "@radix-ui/react-select": "^2.3.3",
        "@radix-ui/react-slot": "^1.3.0",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "@tauri-apps/plugin-opener": "^2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.3.6",
        "lucide-react": "^0.510.0",
        "next-themes": "^0.4.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-i18next": "^17.0.11",
        "react-router-dom": "^7.6.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.2.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@changesets/cli": "^2.31.0",
        "@tauri-apps/cli": "^2",
        "@testing-library/jest-dom": "^6.6.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.0",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^4.4.0",
        "@vitest/coverage-v8": "^4.1.8",
        "autoprefixer": "^10.4.0",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.7",
        "postcss": "^8.5.0",
        "simple-git-hooks": "^2.13.1",
        "tailwindcss": "^3.4.0",
        "typescript": "~5.7.0",
        "vite": "^6.3.0",
        "vitest": "^4.1.8"
    },
    "engines": {
        "node": ">=22"
    },
    "private": true,
    "packageManager": "pnpm@11.6.0",
    "lint-staged": {
        "*": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    }
}
